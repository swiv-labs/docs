{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Swiv Docs",
  "description": "Documentation for Swiv — a private precision market protocol for numerical predictions.",
  "colors": {
    "primary": "#7a4deb",
    "light": "#818CF8",
    "dark": "#08080a"
  },
  "favicon": "/icon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://swiv.xyz"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "mailto:support@swiv.xyz"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index"]
          },
          {
            "group": "How It Works",
            "pages": ["trading", "mechanics", "btc-hourly", "privacy"]
          },
          {
            "group": "Resources",
            "pages": ["faq", "technical", "risks"]
          }
        ]
      },
      {
        "tab": "Legal",
        "groups": [
          {
            "group": "Legal",
            "pages": ["legal/terms", "legal/privacy-policy"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.swiv.xyz"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/swivxyz"
    }
  }
}
